# AutoLemon ERP — LOCAL DEVELOPMENT environment template.
# Copy to .env (never commit .env). Values marked __GENERATE__ are replaced with fresh random
# secrets by `pnpm db:migrate` / `pnpm dev` on first run (scripts/dev-env.mjs).
# DEV-ONLY passwords below protect a Postgres bound to 127.0.0.1; they are NOT secrets for any
# shared or production environment. Production uses a secrets manager (docs/OPERATIONS.md).

NODE_ENV=development

# Docker Compose Postgres (owner/superuser used ONLY by migrations, seed and reset tooling).
POSTGRES_USER=autolemon_owner
POSTGRES_PASSWORD=dev_only_owner_password_change_me
POSTGRES_DB=autolemon
POSTGRES_PORT=5432
DATABASE_URL=postgres://autolemon_owner:dev_only_owner_password_change_me@127.0.0.1:5432/autolemon

# Least-privileged runtime role (RLS applies). Password must match [A-Za-z0-9_-]{12,128}.
APP_DATABASE_URL=postgres://autolemon_app:dev_only_app_password_change_me@127.0.0.1:5432/autolemon
DB_SSL=disable

API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY=false
# Browsers treat http://localhost as a secure context, so Secure cookies work locally.
COOKIE_SECURE=true

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
STEP_UP_MINUTES=5
# Passkeys (WebAuthn). RP ID defaults to the WEB_ORIGIN host name.
# WEBAUTHN_RP_ID=erp.example.pt
# When true, administrators must sign in and step up with a passkey (mandatory in production).
ADMIN_PASSKEY_REQUIRED=false

# UNSAFE FOR PRODUCTION: in-process key-encryption keys for local development only.
KEY_PROVIDER=local-dev
LOCAL_DEV_KEKS=__GENERATE__
CSRF_SECRET=__GENERATE__

ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ENABLED_MODULES=wms
LOG_LEVEL=info
AUTH_THROTTLE_ENABLED=true
