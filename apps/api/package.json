{
  "name": "@autolemon/api",
  "version": "0.6.7",
  "private": true,
  "type": "module",
  "description": "AutoLemon ERP API: NestJS modular monolith (platform + autonomous WMS).",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "db:migrate": "tsx src/db/cli/migrate.ts",
    "db:seed": "tsx src/db/cli/seed.ts",
    "audit:digest": "tsx src/db/cli/audit-digest.ts",
    "db:reset:dev": "tsx src/db/cli/reset-dev.ts",
    "openapi": "tsx src/openapi/generate.ts"
  },
  "dependencies": {
    "@autolemon/contracts": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-fastify": "12.4.2",
    "@node-rs/argon2": "2.2.2",
    "@simplewebauthn/server": "14.1.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "typescript": "6.0.3"
  }
}
